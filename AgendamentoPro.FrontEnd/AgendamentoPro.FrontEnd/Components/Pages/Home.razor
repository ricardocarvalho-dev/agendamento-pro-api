@page "/"
@rendermode InteractiveServer
@using AgendamentoPro.FrontEnd.Services
@inject AgendamentoService AgendamentoService

<PageTitle>Agendamentos</PageTitle>

<h1>Agendamentos</h1>

<p>Listagem de agendamentos e formulário de criação.</p>

<div class="container-fluid py-4">
    <div class="row">
        <div class="col-md-8">
            @if (agendamentos == null)
            {
                <div class="d-flex justify-content-center align-items-center" style="min-height: 200px;">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Carregando...</span>
                    </div>
                </div>
            }
            else
            {
                <h2>Agendamentos Existentes</h2>
                <div class="table-responsive">
                    <table class="table table-striped table-hover shadow-sm rounded">
                        <thead>
                            <tr>
                                <th>ID Agendamento</th>
                                <th>ID Cliente</th>
                                <th>Data e Hora</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var agendamento in agendamentos)
                            {
                                <tr>
                                    <td>@agendamento.AgendamentoId</td>
                                    <td>@(agendamento.ClienteId.ToString().Substring(0, 8))...</td>
                                    <td>@agendamento.DataHora.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>@(string.IsNullOrEmpty(agendamento.Status) ? "N/A" : agendamento.Status)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-header">
                    <h2 class="card-title">Criar Novo Agendamento</h2>
                </div>
                <div class="card-body">
                    <EditForm Model="@newAgendamento" OnValidSubmit="HandleSubmit" FormName="FormCriarAgendamento" Antiforgery="false">
                        <DataAnnotationsValidator />
                        <ValidationSummary />

                        <div class="mb-3">
                            <label for="clienteId" class="form-label">ID Cliente:</label>
                            <InputText id="clienteId" class="form-control" @bind-Value="newAgendamentoClienteIdString" />
                        </div>
                        <div class="mb-3">
                            <label for="dataHora" class="form-label">Data e Hora:</label>
                            <InputDate id="dataHora" class="form-control" @bind-Value="newAgendamento.DataHora" />
                        </div>
                        <div class="mb-3">
                            <label for="status" class="form-label">Status:</label>
                            <InputText id="status" class="form-control" @bind-Value="newAgendamento.Status" />
                        </div>
                        <button type="submit" class="btn btn-primary w-100">Criar Agendamento</button>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private List<AgendamentoDto> agendamentos;
    private AgendamentoCreateDto newAgendamento = new AgendamentoCreateDto();
    private string newAgendamentoClienteIdString = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        agendamentos = await AgendamentoService.GetAgendamentosAsync();
    }

    private async Task HandleSubmit()
    {
        if (Guid.TryParse(newAgendamentoClienteIdString, out Guid clienteId))
        {
            newAgendamento.ClienteId = clienteId;
            await AgendamentoService.CreateAgendamentoAsync(newAgendamento);
            newAgendamento = new AgendamentoCreateDto(); // Clear form
            newAgendamentoClienteIdString = string.Empty;
            agendamentos = await AgendamentoService.GetAgendamentosAsync(); // Refresh list
        }
        else
        {
            // Handle invalid GUID input (e.g., display an error message)
            Console.WriteLine("Invalid Cliente ID");
        }
    }
}